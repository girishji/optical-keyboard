    (uuid 5521c875-b3ba-45bb-bc8c-99a8bfb7f011)
  )
  (text "LDO 3.3V/300mA, TSOP5 package: \nOn Semi NCP114ASN330T1G \nRichtek RT9078-33GJ5"
    (at 193.04 152.4 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 5ac61544-4e56-4942-aaad-3bf1f40dbb1d)
  )
  (text "HSUSB Cap" (at 313.69 129.54 0)
    (effects (font (size 3.048 3.048) bold) (justify left bottom))
    (uuid 8976a499-b966-4291-8472-dfeedf7bee01)
  )
  (text "Nuvoton M487SIDAE MCU" (at 62.23 25.4 0)
    (effects (font (size 3.048 3.048) bold) (justify left bottom))
    (uuid a5a49af3-359f-4450-b5ef-e5f9340d0e8a)
  )
  (text "NCP114:\nInput Capacitor Selection (CIN)\nIt is recommended to connect at least a 1uF Ceramic X5R\nor X7R capacitor as close as possible to the IN pin of the\ndevice.\nOutput Decoupling (COUT)\nThe NCP114 requires an output capacitor connected as\nclose as possible to the output pin of the regulator. The\nrecommended capacitor value is 1uF and X7R or X5R\ndielectric due to its low capacitance variations over the\nspecified temperature range. It is not recommended to use \ntantalum capacitors on the output due\nto their large ESR. "
    (at 179.07 180.34 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid a5ec6847-e7da-4986-8699-25f25cdeab8d)
  )
  (text "HXT & LXT Crystal" (at 186.69 34.29 0)
    (effects (font (size 3.048 3.048) bold) (justify left bottom))
    (uuid d52ca0ac-78ac-4a8d-9398-e8c4058bc54b)
  )
  (text "Bypass Cap" (at 316.23 54.61 0)
    (effects (font (size 3.048 3.048) bold) (justify left bottom))
    (uuid e482ab08-67dc-4285-b6e7-337a29c24cb7)
  )
  (text "VDDIO / VREF Source\n" (at 174.625 219.71 0)
    (effects (font (size 3.048 3.048) bold) (justify left bottom))
    (uuid fabe4530-c139-4ce7-9d2b-7711b2ff2546)
  )

